* text=auto eol=lf
*.bat text eol=crlf
*.sln text eol=crlf
*.png binary
*.jpg binary
*.exr binary
*.hdr binary
*.glb binary
*.gltf -text
# Test data is generator output: keep it byte-for-byte (manifests hold checksums of siblings).
tests/data/** -text

# NoorMD exports: manifests hold SHA-256s of their sibling files, so keep them byte for byte.
samples/Hillside/Assets/Trees/** -text
samples/Hillside/Assets/Rocks/** -text
samples/Hillside/Assets/Plants/** -text
