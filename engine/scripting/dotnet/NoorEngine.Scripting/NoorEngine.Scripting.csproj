<Project Sdk="Microsoft.NET.Sdk">
  <!--
    NoorEngine.Scripting: the managed half of C# scripting (ADR-008). Scripts reference this
    library; hosts (NoorEditor now, the player later) load it and hand the engine its host table.
    The engine half is engine/scripting (noor_rt_api.h).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>NoorEngine</RootNamespace>
    <AssemblyName>NoorEngine.Scripting</AssemblyName>
    <Version>0.4.0</Version>
    <!-- noor_player hosts .NET itself (hostfxr) and needs this library's runtimeconfig.json. -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
</Project>
