# The 8D sample in a built game (Milestone 8D, part 8): samples/Hillside's Hillside_Water (the lake in the rain, a stream,
# four floating crates, Alden wading in and swimming across) runs 900 frames (fifteen seconds: he's swimming by then) in
# the project and in the built Hillside game, and must play the same: Alden in the same place to the bit and swimming
# (his controller in its Swim state), every bone posed the same, every crate in the same place.
#   -DPLAYER=<noor_player> -DGAME=<the built Hillside.exe> -DPROJECT=<samples/Hillside> -DWORK=<folder>
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(args --scene Scenes/Hillside_Water.noorscene --frames 900 --no-audio --no-input)
execute_process(COMMAND "${PLAYER}" "${PROJECT}" ${args} --report "${WORK}/project.json" --log "${WORK}/project.log"
                RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
if(NOT code EQUAL 0 OR NOT EXISTS "${WORK}/project.json")
    message(FATAL_ERROR "noor_player failed on the sample (${code}); see ${WORK}/project.log")
endif()
execute_process(COMMAND "${GAME}" ${args} --report "${WORK}/game.json" --log "${WORK}/game.log" RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
if(NOT code EQUAL 0 OR NOT EXISTS "${WORK}/game.json")
    message(FATAL_ERROR "the built Hillside game failed (${code}); see ${WORK}/game.log")
endif()
file(READ "${WORK}/project.json" a)
file(READ "${WORK}/game.json" b)
foreach(side a b)
    string(JSON ${side}_print GET "${${side}}" animation fingerprint)
    string(JSON ${side}_state GET "${${side}}" animation entities 0 animation)
    string(JSON ${side}_at GET "${${side}}" entities "Alden Wayfarer")
    string(JSON ${side}_errors GET "${${side}}" errors)
endforeach()
message(STATUS "project:    Alden ${a_state} at ${a_at}, fingerprint ${a_print}")
message(STATUS "built game: Alden ${b_state} at ${b_at}, fingerprint ${b_print}")
if(NOT a_errors EQUAL 0 OR NOT b_errors EQUAL 0)
    message(FATAL_ERROR "errors were logged: see ${WORK}/project.log and ${WORK}/game.log")
endif()
if(NOT a_state STREQUAL "Swim")
    message(FATAL_ERROR "Alden isn't swimming fifteen seconds in (state ${a_state})")
endif()
if(NOT a_print STREQUAL b_print OR NOT a_at STREQUAL b_at)
    message(FATAL_ERROR "the built game's Alden differs from the project's")
endif()
foreach(n 1 2 3 4)
    string(JSON ca GET "${a}" entities "Crate ${n}")
    string(JSON cb GET "${b}" entities "Crate ${n}")
    message(STATUS "Crate ${n}: project ${ca}, built game ${cb}")
    if(NOT ca STREQUAL cb)
        message(FATAL_ERROR "Crate ${n} is somewhere else in the built game")
    endif()
    string(JSON y GET "${a}" entities "Crate ${n}" 1)
    if(y LESS 2.8 OR y GREATER 3.6)
        message(FATAL_ERROR "Crate ${n} isn't floating on the lake (y ${y}; the water is at 3.30)")
    endif()
endforeach()
