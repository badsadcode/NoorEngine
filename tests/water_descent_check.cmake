# Underwater (Milestone 8D, part 4): a camera walked down through the water's surface sees no pop.
#   -DPLAYER=<noor_player> -DPROJECT=<tests/data/render_scenes> -DWORK=<folder>
# Water_Waterline (a calm pond, the camera level with its surface) is drawn with its camera at heights from 30 cm above
# the water to 30 cm under it, in half-centimetre steps through the surface itself (where the waterline sweeps across
# the picture: the near plane is about 5 cm tall). Each picture's average colour (noor_player's "mean_rgb") must change
# a little at a time: no single step more than a third of the whole change from above to under the water. Lighting,
# exposure or fog switching on at one height (a pop) would be one big step.
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
file(COPY "${PROJECT}/" DESTINATION "${WORK}/project" PATTERN ".noor" EXCLUDE)
file(READ "${PROJECT}/Scenes/Water_Waterline.noorscene" scene)
string(JSON count LENGTH "${scene}" entities)
math(EXPR last "${count} - 1")
set(camera -1)
foreach(i RANGE ${last})
    string(JSON name GET "${scene}" entities ${i} name)
    if(name STREQUAL "Camera")
        set(camera ${i})
    endif()
endforeach()
if(camera LESS 0)
    message(FATAL_ERROR "Water_Waterline has no Camera")
endif()
string(JSON level GET "${scene}" entities ${camera} transform position 1)  # the camera starts level with the water

# Offsets in millimetres (CMake's math is integers): far above, through the surface finely, far under.
set(offsets 300 150 80)
foreach(mm RANGE 60 -60 -5)
    list(APPEND offsets ${mm})
endforeach()
list(APPEND offsets -80 -150 -300)

set(means "")
foreach(mm IN LISTS offsets)
    math(EXPR whole "${mm} / 1000")
    if(mm LESS 0)
        math(EXPR frac "(-${mm}) % 1000")
        set(sign "-")
    else()
        math(EXPR frac "${mm} % 1000")
        set(sign "")
    endif()
    string(LENGTH "${frac}" n)
    if(n EQUAL 1)
        set(frac "00${frac}")
    elseif(n EQUAL 2)
        set(frac "0${frac}")
    endif()
    # The camera's height: the level plus the offset (as text, so no float maths is needed: offsets are a few cm).
    set(offset "${sign}0.${frac}")
    # y = level + offset, worked out in millimetres from the level written to 3 decimals.
    string(REGEX MATCH "^(-?)([0-9]+)\\.?([0-9]*)" _ "${level}")
    set(ls "${CMAKE_MATCH_1}")
    set(li "${CMAKE_MATCH_2}")
    set(lf "${CMAKE_MATCH_3}000")
    string(SUBSTRING "${lf}" 0 3 lf)
    math(EXPR level_mm "${li} * 1000 + ${lf}")
    if(ls STREQUAL "-")
        math(EXPR level_mm "-${level_mm}")
    endif()
    math(EXPR y_mm "${level_mm} + ${mm}")
    if(y_mm LESS 0)
        math(EXPR ay "-${y_mm}")
        set(ys "-")
    else()
        set(ay ${y_mm})
        set(ys "")
    endif()
    math(EXPR yi "${ay} / 1000")
    math(EXPR yf "${ay} % 1000")
    string(LENGTH "${yf}" n)
    if(n EQUAL 1)
        set(yf "00${yf}")
    elseif(n EQUAL 2)
        set(yf "0${yf}")
    endif()
    string(JSON moved SET "${scene}" entities ${camera} transform position 1 "${ys}${yi}.${yf}")
    file(WRITE "${WORK}/project/Scenes/Descent.noorscene" "${moved}")
    execute_process(COMMAND "${PLAYER}" "${WORK}/project" --scene Scenes/Descent.noorscene --frames 20 --no-audio --no-input
                            --report "${WORK}/report_${mm}.json" --log "${WORK}/player_${mm}.log"
                    RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
    if(NOT code EQUAL 0 OR NOT EXISTS "${WORK}/report_${mm}.json")
        message(FATAL_ERROR "noor_player failed (${code}) at ${mm} mm; see ${WORK}/player_${mm}.log")
    endif()
    file(READ "${WORK}/report_${mm}.json" report)
    string(JSON errors GET "${report}" errors)
    if(NOT errors EQUAL 0)
        message(FATAL_ERROR "errors were logged at ${mm} mm; see ${WORK}/player_${mm}.log")
    endif()
    # The average brightness, in hundredths (integers from here on).
    string(JSON r GET "${report}" mean_rgb 0)
    string(JSON g GET "${report}" mean_rgb 1)
    string(JSON b GET "${report}" mean_rgb 2)
    foreach(c r g b)
        string(REGEX REPLACE "^([0-9]+)\\.?([0-9]?[0-9]?).*" "\\1;\\2" parts "${${c}}")
        list(GET parts 0 ci)
        list(LENGTH parts np)
        set(cf 0)
        if(np GREATER 1)
            list(GET parts 1 cf)
            string(LENGTH "${cf}" nf)
            if(nf EQUAL 1)
                set(cf "${cf}0")
            elseif(nf EQUAL 0)
                set(cf 0)
            endif()
        endif()
        math(EXPR ${c}_h "${ci} * 100 + ${cf}")
    endforeach()
    math(EXPR mean_h "(${r_h} + ${g_h} + ${b_h}) / 3")
    list(APPEND means ${mean_h})
    message(STATUS "camera ${offset} m from the water: average ${mean_h} (hundredths of a level)")
endforeach()

list(GET means 0 first)
list(GET means -1 final)
math(EXPR total "${first} - ${final}")
if(total LESS 0)
    math(EXPR total "-${total}")
endif()
list(LENGTH means n)
math(EXPR steps "${n} - 2")
set(biggest 0)
foreach(i RANGE ${steps})
    math(EXPR j "${i} + 1")
    list(GET means ${i} a)
    list(GET means ${j} b)
    math(EXPR d "${a} - ${b}")
    if(d LESS 0)
        math(EXPR d "-${d}")
    endif()
    if(d GREATER biggest)
        set(biggest ${d})
    endif()
endforeach()
message(STATUS "above to under: ${total}; the biggest step: ${biggest}")
if(total LESS 500)
    message(FATAL_ERROR "the picture hardly changes from above to under the water (${total}): is the camera going under?")
endif()
math(EXPR limit "${total} / 3")
if(biggest GREATER limit)
    message(FATAL_ERROR "a pop: one step changed the picture by ${biggest}, more than a third of the whole change (${total})")
endif()
