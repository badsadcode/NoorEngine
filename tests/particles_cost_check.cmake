# What particles cost (Milestone 8B, part 2): render_scenes/Particles_Heavy (10,000 big, overlapping, alpha-blended
# smoke particles, sorted back to front every frame) and Particles_Campfire (about a hundred: fire, smoke, sparks)
# against Atmosphere_Noon (the same objects, no particles). Judged on each run's fastest GPU frame, like the other GPU
# cost tests (a desktop GPU idles clocked down and is shared). Budgets: the heavy scene 1.5 ms of GPU over the plain
# one (measured 0.58), its simulation under 1 ms of CPU (measured 0.04); the campfire 0.1 ms (measured 0.005).
#   -DPLAYER=<noor_player> -DPROJECT=<render_scenes> -DWORK=<folder>
file(MAKE_DIRECTORY "${WORK}")
function(run scene report)
    file(REMOVE "${report}")
    execute_process(COMMAND "${PLAYER}" "${PROJECT}" --scene ${scene} --frames 300 --no-audio --no-input --report "${report}" --log "${report}.log"
                    RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
    if(NOT code EQUAL 0 OR NOT EXISTS "${report}")
        message(FATAL_ERROR "noor_player failed on ${scene} (${code}); see ${report}.log")
    endif()
endfunction()
function(microseconds value out)  # "1.234" ms -> 1234
    string(REGEX REPLACE "^([0-9]+)[.]?([0-9]*).*" "\\1" whole "${value}")
    string(REGEX REPLACE "^([0-9]+)[.]?([0-9]*).*" "\\2000" frac "${value}")
    string(SUBSTRING "${frac}" 0 3 frac)
    math(EXPR us "${whole} * 1000 + ${frac}")
    set(${out} ${us} PARENT_SCOPE)
endfunction()
run(Scenes/Atmosphere_Noon.noorscene "${WORK}/plain.json")
run(Scenes/Particles_Campfire.noorscene "${WORK}/campfire.json")
run(Scenes/Particles_Heavy.noorscene "${WORK}/heavy.json")
file(READ "${WORK}/plain.json" plain)
file(READ "${WORK}/campfire.json" campfire)
file(READ "${WORK}/heavy.json" heavy)
string(JSON plain_gpu GET "${plain}" timing_ms gpu min)
string(JSON campfire_gpu GET "${campfire}" timing_ms gpu min)
string(JSON heavy_gpu GET "${heavy}" timing_ms gpu min)
string(JSON heavy_sim GET "${heavy}" timing_ms particles min)
string(JSON heavy_alive GET "${heavy}" particles alive)
microseconds(${plain_gpu} plain_us)
microseconds(${campfire_gpu} campfire_us)
microseconds(${heavy_gpu} heavy_us)
microseconds(${heavy_sim} sim_us)
math(EXPR campfire_extra "${campfire_us} - ${plain_us}")
math(EXPR heavy_extra "${heavy_us} - ${plain_us}")
message(STATUS "particles: campfire +${campfire_extra} us; ${heavy_alive} heavy smoke particles +${heavy_extra} us of GPU, simulated in ${sim_us} us")
if(NOT heavy_alive EQUAL 10000)
    message(FATAL_ERROR "the heavy scene should have 10,000 particles (it has ${heavy_alive})")
endif()
if(heavy_extra GREATER 1500)
    message(FATAL_ERROR "10,000 particles cost ${heavy_extra} us of GPU a frame (budget 1500)")
endif()
if(sim_us GREATER 1000)
    message(FATAL_ERROR "simulating 10,000 particles took ${sim_us} us (budget 1000)")
endif()
if(campfire_extra GREATER 100)
    message(FATAL_ERROR "the campfire costs ${campfire_extra} us of GPU a frame (budget 100)")
endif()
# Rain (8B part 3): Weather_Rain (200,000 drops, worked out in the vertex shader) against Atmosphere_Overcast (the same
# scene, dry). The plan's budget: 0.5 ms (measured 0.18).
run(Scenes/Atmosphere_Overcast.noorscene "${WORK}/dry.json")
run(Scenes/Weather_Rain.noorscene "${WORK}/rain.json")
file(READ "${WORK}/dry.json" dry)
file(READ "${WORK}/rain.json" rain)
string(JSON dry_gpu GET "${dry}" timing_ms gpu min)
string(JSON rain_gpu GET "${rain}" timing_ms gpu min)
microseconds(${dry_gpu} dry_us)
microseconds(${rain_gpu} rain_us)
math(EXPR rain_extra "${rain_us} - ${dry_us}")
message(STATUS "rain: 200,000 drops +${rain_extra} us of GPU")
if(rain_extra GREATER 500)
    message(FATAL_ERROR "200,000 raindrops cost ${rain_extra} us of GPU a frame (budget 500)")
endif()
# Budgets (8B part 7): Particles_Budget, 50 spark fountains bouncing on the floor that together ask for 150,000
# particles, against the scene's default budget of 100,000: never more alive than that, the rest held back, and what's
# alive costs little. Budgets: CPU 2 ms for the colliding simulation (measured 1.0), GPU 1.5 ms over the plain scene
# (measured 0.11).
run(Scenes/Particles_Budget.noorscene "${WORK}/budget.json")
file(READ "${WORK}/budget.json" budget)
string(JSON budget_alive GET "${budget}" particles alive)
string(JSON budget_held GET "${budget}" particles throttled)
string(JSON budget_gpu GET "${budget}" timing_ms gpu min)
string(JSON budget_sim GET "${budget}" timing_ms particles min)
microseconds(${budget_gpu} budget_us)
microseconds(${budget_sim} budget_sim_us)
math(EXPR budget_extra "${budget_us} - ${plain_us}")
message(STATUS "budget: 50 emitters, ${budget_alive} particles alive (budget 100000), ${budget_held} held back; +${budget_extra} us of GPU, simulated in ${budget_sim_us} us")
if(budget_alive GREATER 100000 OR budget_held EQUAL 0)
    message(FATAL_ERROR "the scene's particle budget didn't hold (${budget_alive} alive, ${budget_held} held back)")
endif()
if(budget_sim_us GREATER 2000)
    message(FATAL_ERROR "50 colliding emitters took ${budget_sim_us} us to simulate (budget 2000)")
endif()
if(budget_extra GREATER 1500)
    message(FATAL_ERROR "50 emitters' particles cost ${budget_extra} us of GPU a frame (budget 1500)")
endif()
