# Effect particles replay identically in a built game (Milestone 8B, part 1, ADR-035): render_scenes/Particles_Campfire
# (fire from a cone, smoke from a .noorfx asset with an override, sparks in repeating bursts, a breeze from the
# environment) runs 300 frames in the project and in a game built by noor_cli; the player's report has a fingerprint of
# every particle (positions, velocities, ages, bit for bit), and the two must be equal, with all three emitters running.
#   -DCLI=<noor_cli> -DPLAYER=<noor_player> -DPROJECT=<render_scenes> -DWORK=<folder>
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
file(COPY "${PROJECT}/" DESTINATION "${WORK}/project")
file(REMOVE_RECURSE "${WORK}/project/.noor")
set(args --scene Scenes/Particles_Campfire.noorscene --frames 300 --no-audio --no-input)
execute_process(COMMAND "${PLAYER}" "${WORK}/project" ${args} --report "${WORK}/project.json" --log "${WORK}/project.log"
                RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
if(NOT code EQUAL 0 OR NOT EXISTS "${WORK}/project.json")
    message(FATAL_ERROR "noor_player failed on the project (${code}); see ${WORK}/project.log")
endif()
execute_process(COMMAND "${CLI}" build "${WORK}/project" "${WORK}/game" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "noor_cli build failed (${code}): ${out}${err}")
endif()
file(GLOB exe "${WORK}/game/*.exe")
execute_process(COMMAND "${exe}" ${args} --report "${WORK}/game.json" --log "${WORK}/game.log" RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
if(NOT code EQUAL 0 OR NOT EXISTS "${WORK}/game.json")
    message(FATAL_ERROR "the built game failed (${code}); see ${WORK}/game.log")
endif()
file(READ "${WORK}/project.json" a)
file(READ "${WORK}/game.json" b)
string(JSON a_emitters GET "${a}" particles emitters)
string(JSON a_alive GET "${a}" particles alive)
string(JSON a_print GET "${a}" particles fingerprint)
string(JSON b_emitters GET "${b}" particles emitters)
string(JSON b_alive GET "${b}" particles alive)
string(JSON b_print GET "${b}" particles fingerprint)
string(JSON a_errors GET "${a}" errors)
string(JSON b_errors GET "${b}" errors)
message(STATUS "project: ${a_emitters} emitters, ${a_alive} particles, fingerprint ${a_print}")
message(STATUS "built game: ${b_emitters} emitters, ${b_alive} particles, fingerprint ${b_print}")
if(NOT a_errors EQUAL 0 OR NOT b_errors EQUAL 0)
    message(FATAL_ERROR "errors were logged: see ${WORK}/project.log and ${WORK}/game.log")
endif()
if(NOT a_emitters EQUAL 3 OR a_alive LESS 50)
    message(FATAL_ERROR "the campfire isn't running in the project (3 emitters and dozens of particles expected)")
endif()
if(NOT a_print STREQUAL b_print OR NOT a_alive EQUAL b_alive)
    message(FATAL_ERROR "the built game's particles differ from the project's")
endif()
