# noor_cli build: packs a project with the player and writes game.json; refuses unsafe outputs.
#   -DCLI=<noor_cli> -DPROJECT=<project folder> -DOUT=<output folder>
file(REMOVE_RECURSE "${OUT}")
execute_process(COMMAND "${CLI}" build "${PROJECT}" "${OUT}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
message(STATUS "${out}${err}")
if(NOT code EQUAL 0)
    message(FATAL_ERROR "build failed (${code})")
endif()
foreach(f "Player Test.exe" game.json game/Scenes/Main.noorscene game/Scripts/Rider.luau "game/Player Test.noorproj")
    if(NOT EXISTS "${OUT}/${f}")
        message(FATAL_ERROR "missing from the build: ${f}")
    endif()
endforeach()
if(EXISTS "${OUT}/game/.noor")
    message(FATAL_ERROR "derived data (.noor) was copied")
endif()
file(READ "${OUT}/game.json" json)
string(JSON scene GET "${json}" start_scene)
if(NOT scene STREQUAL "Scenes/Main.noorscene")
    message(FATAL_ERROR "start scene is '${scene}'")
endif()

# Building again replaces the earlier build.
execute_process(COMMAND "${CLI}" build "${PROJECT}" "${OUT}" RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "rebuilding over an earlier build failed (${code})")
endif()
# A folder that has other things in it is refused, and so is a folder inside the project.
set(other "${OUT}_other")
file(REMOVE_RECURSE "${other}")
file(WRITE "${other}/keep.txt" "not a build")
execute_process(COMMAND "${CLI}" build "${PROJECT}" "${other}" RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
if(code EQUAL 0 OR NOT EXISTS "${other}/keep.txt")
    message(FATAL_ERROR "built into a folder with other files in it")
endif()
execute_process(COMMAND "${CLI}" build "${PROJECT}" "${PROJECT}/Builds" RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
if(code EQUAL 0 OR EXISTS "${PROJECT}/Builds")
    message(FATAL_ERROR "built into a folder inside the project")
endif()
file(REMOVE_RECURSE "${other}")
