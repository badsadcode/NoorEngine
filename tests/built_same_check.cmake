# A sample in a built game plays exactly as in its project (2D part 7): the same frames run in both must leave the same
# entity where it is, to the bit, and show the same HUD, with no errors logged.
#   -DPLAYER=<noor_player> -DGAME=<the built .exe> -DPROJECT=<sample folder> -DFRAMES=<n> -DENTITY=<name> -DWORK=<folder>
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(args --frames ${FRAMES} --no-audio --no-input --windowed)
execute_process(COMMAND "${PLAYER}" "${PROJECT}" ${args} --report "${WORK}/project.json" --log "${WORK}/project.log"
                RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
if(NOT code EQUAL 0 OR NOT EXISTS "${WORK}/project.json")
    message(FATAL_ERROR "noor_player failed (${code}); see ${WORK}/project.log")
endif()
execute_process(COMMAND "${GAME}" ${args} --report "${WORK}/game.json" --log "${WORK}/game.log" RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
if(NOT code EQUAL 0 OR NOT EXISTS "${WORK}/game.json")
    message(FATAL_ERROR "the built game failed (${code}); see ${WORK}/game.log")
endif()
file(READ "${WORK}/project.json" a)
file(READ "${WORK}/game.json" b)
foreach(side a b)
    string(JSON ${side}_at GET "${${side}}" entities "${ENTITY}")
    string(JSON ${side}_hud GET "${${side}}" hud_text)
    string(JSON ${side}_errors GET "${${side}}" errors)
endforeach()
message(STATUS "project:    ${ENTITY} ${a_at}, HUD ${a_hud}")
message(STATUS "built game: ${ENTITY} ${b_at}, HUD ${b_hud}")
if(NOT a_errors EQUAL 0 OR NOT b_errors EQUAL 0)
    message(FATAL_ERROR "errors were logged: see ${WORK}/project.log and ${WORK}/game.log")
endif()
if(NOT a_at STREQUAL b_at OR NOT a_hud STREQUAL b_hud)
    message(FATAL_ERROR "the built game played differently")
endif()
