# NoorPong in a built game (Milestone 9A, part 1): the computer playing both sides for twenty seconds, in the project and
# in the built game, must play the same game: the ball and both bats in the same places to the bit, the same score, and
# at least one point scored (the computer isn't perfect, so the game moves on).
#   -DPLAYER=<noor_player> -DGAME=<the built NoorPong.exe> -DPROJECT=<samples/NoorPong> -DWORK=<folder>
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(args --frames 1200 --no-audio --no-input)
execute_process(COMMAND "${PLAYER}" "${PROJECT}" ${args} --report "${WORK}/project.json" --log "${WORK}/project.log"
                RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
if(NOT code EQUAL 0 OR NOT EXISTS "${WORK}/project.json")
    message(FATAL_ERROR "noor_player failed on NoorPong (${code}); see ${WORK}/project.log")
endif()
execute_process(COMMAND "${GAME}" ${args} --report "${WORK}/game.json" --log "${WORK}/game.log" RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
if(NOT code EQUAL 0 OR NOT EXISTS "${WORK}/game.json")
    message(FATAL_ERROR "the built NoorPong failed (${code}); see ${WORK}/game.log")
endif()
file(READ "${WORK}/project.json" a)
file(READ "${WORK}/game.json" b)
foreach(side a b)
    string(JSON ${side}_ball GET "${${side}}" entities Ball)
    string(JSON ${side}_left GET "${${side}}" entities "Left Bat")
    string(JSON ${side}_right GET "${${side}}" entities "Right Bat")
    string(JSON ${side}_score GET "${${side}}" hud_text 0)
    string(JSON ${side}_errors GET "${${side}}" errors)
endforeach()
message(STATUS "project:    score '${a_score}', ball ${a_ball}, bats ${a_left} ${a_right}")
message(STATUS "built game: score '${b_score}', ball ${b_ball}, bats ${b_left} ${b_right}")
if(NOT a_errors EQUAL 0 OR NOT b_errors EQUAL 0)
    message(FATAL_ERROR "errors were logged: see ${WORK}/project.log and ${WORK}/game.log")
endif()
string(REGEX REPLACE " +" ":" score "${a_score}")
if(score STREQUAL "0:0")
    message(FATAL_ERROR "nobody scored in twenty seconds")
endif()
if(NOT a_ball STREQUAL b_ball OR NOT a_left STREQUAL b_left OR NOT a_right STREQUAL b_right OR NOT a_score STREQUAL b_score)
    message(FATAL_ERROR "the built game's NoorPong differs from the project's")
endif()
