# Water in the game (Milestone 8D, part 5): floating bodies and splashes are the same in a built game.
#   -DPLAYER=<noor_player> -DPROJECT=<tests/data/render_scenes> -DGAME=<the built render_scenes game> -DWORK=<folder>
# Water_Float (the Sea preset in the rain: two planks, a crate and a barrel of different densities floating on its waves,
# pebbles dropping into it and splashing) runs 300 frames in the project and in the built game: each floating body in
# the same place to the bit, riding the water (neither sunk nor flying), and the same number of splashes, more than none.
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(args --scene Scenes/Water_Float.noorscene --frames 300 --no-audio --no-input)
execute_process(COMMAND "${PLAYER}" "${PROJECT}" ${args} --report "${WORK}/project.json" --log "${WORK}/project.log"
                RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
if(NOT code EQUAL 0 OR NOT EXISTS "${WORK}/project.json")
    message(FATAL_ERROR "noor_player failed (${code}); see ${WORK}/project.log")
endif()
execute_process(COMMAND "${GAME}" ${args} --report "${WORK}/game.json" --log "${WORK}/game.log" RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
if(NOT code EQUAL 0 OR NOT EXISTS "${WORK}/game.json")
    message(FATAL_ERROR "the built game failed (${code}); see ${WORK}/game.log")
endif()
file(READ "${WORK}/project.json" a)
file(READ "${WORK}/game.json" b)
foreach(side a b)
    string(JSON ${side}_errors GET "${${side}}" errors)
    string(JSON ${side}_splashes GET "${${side}}" particles splashes)
endforeach()
if(NOT a_errors EQUAL 0 OR NOT b_errors EQUAL 0)
    message(FATAL_ERROR "errors were logged: see ${WORK}/project.log and ${WORK}/game.log")
endif()
message(STATUS "splashes: project ${a_splashes}, built game ${b_splashes}")
if(NOT a_splashes EQUAL b_splashes OR a_splashes LESS 1)
    message(FATAL_ERROR "the splashes differ (or there were none)")
endif()
foreach(name "Plank light" "Plank" "Crate" "Barrel")
    string(JSON at_a GET "${a}" entities "${name}")
    string(JSON at_b GET "${b}" entities "${name}")
    message(STATUS "${name}: project ${at_a}, built game ${at_b}")
    if(NOT at_a STREQUAL at_b)
        message(FATAL_ERROR "${name} is somewhere else in the built game")
    endif()
    string(JSON y GET "${a}" entities "${name}" 1)
    if(y LESS -1.2 OR y GREATER 0.8)
        message(FATAL_ERROR "${name} isn't floating (y ${y}): the Sea's waves reach 0.6 m either way")
    endif()
endforeach()
