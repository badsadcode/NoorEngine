{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/badsadcode/NoorEngine/blob/main/docs/interchange/noor.asset.schema.json",
  "title": "Noor Interchange asset manifest (<name>.noor.json)",
  "description": "Metadata sidecar for an asset exported by a Noor tool. See NOOR_INTERCHANGE.md. Unknown fields are allowed and must be ignored by readers.",
  "type": "object",
  "required": [
    "noor_interchange",
    "id",
    "name",
    "kind",
    "generator",
    "created",
    "space",
    "files"
  ],
  "properties": {
    "noor_interchange": {
      "description": "Version of the Noor Interchange spec this manifest follows.",
      "type": "string",
      "pattern": "^0\\.[0-9]+$"
    },
    "id": {
      "description": "Stable asset identity (UUID). Created on first generation and stored in the recipe so regeneration keeps it.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "kind": {
      "description": "Dotted category. Add new kinds to NOOR_INTERCHANGE.md before using them.",
      "type": "string",
      "enum": [
        "building",
        "ship",
        "vehicle",
        "level",
        "prop",
        "rock",
        "vegetation.tree",
        "vegetation.plant",
        "vegetation.scatter",
        "road",
        "bridge",
        "material",
        "terrain",
        "character"
      ]
    },
    "generator": {
      "type": "object",
      "required": [
        "tool",
        "version"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "pattern": "^Noor[A-Za-z]+$|^Bad[A-Za-z]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string"
        },
        "determinism": {
          "enum": [
            "cross_platform",
            "same_platform",
            "none"
          ]
        }
      }
    },
    "recipe": {
      "type": "object",
      "required": [
        "file",
        "seed"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Unsigned 64-bit seed. Do not parse as signed or floating point."
        },
        "sha256": {
          "type": "string"
        }
      }
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "space": {
      "type": "object",
      "required": [
        "up",
        "forward",
        "handedness",
        "units"
      ],
      "properties": {
        "up": {
          "const": "+Y"
        },
        "forward": {
          "const": "+Z"
        },
        "handedness": {
          "const": "right"
        },
        "units": {
          "const": "meters"
        }
      }
    },
    "bounds": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "$ref": "#/$defs/vec3"
        },
        "max": {
          "$ref": "#/$defs/vec3"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[^/\\\\:]+$",
            "description": "File name next to the manifest (no folders, no absolute paths)."
          },
          "role": {
            "enum": [
              "model",
              "lod",
              "recipe",
              "validation",
              "preview",
              "texture",
              "other"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "lod": {
            "type": "integer",
            "minimum": 1,
            "description": "Level of detail held by a role 'lod' file (LOD0 is the model file)."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "const": "lod"
                }
              }
            },
            "then": {
              "required": [
                "lod"
              ]
            }
          }
        ]
      }
    },
    "lods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "level"
        ],
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 0
          },
          "triangles": {
            "type": "integer",
            "minimum": 0
          },
          "max_distance": {
            "type": "number",
            "minimum": 0,
            "description": "v0.4: metres from the camera up to which this level is used, for a 60 degree vertical field of view (engines scale it for theirs). 0 or missing on the last level: no limit."
          },
          "billboard": {
            "type": "boolean",
            "description": "v0.4: this level is camera-facing cards (an impostor/billboard)."
          }
        }
      }
    },
    "family": {
      "description": "v0.4: variants that belong together (a variety pack).",
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "variant": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "wind": {
      "description": "v0.4: where wind data lives in the vertex attributes, e.g. {\"bend\": \"TEXCOORD_1.x\"}.",
      "type": "object",
      "properties": {
        "channels": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^(TEXCOORD_[0-9]+|COLOR_[0-9]+)\\.[xyzw]$" }
        }
      }
    },
    "collision": {
      "enum": [
        "none",
        "mesh",
        "convex",
        "box",
        "sphere",
        "capsule",
        "generated"
      ]
    },
    "markers": {
      "description": "Count of marker nodes per marker type.",
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "description": "Which attributes were measured vs. requested vs. guessed (e.g. osm / request / inferred).",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "license": {
      "type": "object",
      "properties": {
        "spdx": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "attribution": {
          "type": "string",
          "description": "Exact credit line required by this asset's sources (empty = none). Collected into credits screens."
        }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "gltf_validator": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
