<rml>
<head>
    <title>Paused</title>
    <style>
        body {
            width: 100%; height: 100%;
            font-family: "Atkinson Hyperlegible"; font-size: 32dp;
            background-color: #0000008C;
            display: flex; justify-content: center; align-items: center;
        }
        #menu {
            width: 360dp; padding: 32dp;
            background-color: #191623F2;
            border-radius: 12dp;
            display: flex; flex-direction: column;
        }
        h1 {
            font-size: 64dp; color: #FFC857; text-align: center; margin-bottom: 8dp;
        }
        button {
            display: block; margin-top: 16dp; padding: 12dp 24dp;
            color: #EDE8F7; text-align: center;
            background-color: #2A2140; border-radius: 8dp;
            focus: auto; tab-index: auto;
        }
        button:focus {
            background-color: #4B1AF2;
            border: 3dp #FFFFFFE6;
        }
    </style>
</head>
<body>
    <div id="menu">
        <h1>Paused</h1>
        <button id="resume">Resume</button>
        <button id="settings">Settings</button>
        <button id="quit">Quit</button>
    </div>
</body>
</rml>
