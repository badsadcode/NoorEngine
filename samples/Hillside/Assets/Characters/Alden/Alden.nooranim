{
  "noor_anim": 1,
  "parameters": {
    "speed": {
      "type": "float",
      "default": 0
    },
    "swimming": {
      "type": "bool",
      "default": false
    }
  },
  "layers": [
    {
      "name": "Base",
      "entry": "Move",
      "states": [
        {
          "name": "Move",
          "blend": {
            "x": "speed",
            "samples": [
              {
                "clip": "Idle",
                "x": 0
              },
              {
                "clip": "WalkForward",
                "x": 1.4
              },
              {
                "clip": "RunForward",
                "x": 4
              }
            ]
          }
        },
        {
          "name": "Swim",
          "clip": "SwimForward"
        }
      ],
      "transitions": [
        {
          "from": "Move",
          "to": "Swim",
          "when": [
            {
              "parameter": "swimming",
